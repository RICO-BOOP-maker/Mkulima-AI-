# ===========================================
# Mkulima AI — Environment Variables
# ===========================================
# Copy this file to .env and fill in your real keys:
#   cp .env.example .env
#
# NEVER commit the .env file with real keys!
# ===========================================

# 1. Gemini AI API Key (Required)
# Get yours at: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Environment (development | production)
VITE_ENV=development

# 3. AI Model
VITE_API_MODEL=gemini-2.5-flash

# 4. Google Custom Search API Key (Optional — for future search features)
VITE_GOOGLE_SEARCH_KEY=your_google_search_key_here

# 5. Programmable Search Engine ID (Optional — for future search features)
VITE_SEARCH_ENGINE_ID=your_search_engine_id_here
